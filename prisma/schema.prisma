generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int    @id @default(autoincrement())
  user_id String @unique @default(dbgenerated("(auth.jwt() ->> 'sub'::text)"))

  typing_results             TypingResults[]
  typing_coach_ai_runs       TypingCoachAiRun[]
  weekly_xp                  WeeklyXp[]
  leaderboard_all_time_60s   LeaderboardAllTime60s[]
  leaderboard_all_time_15s   LeaderboardAllTime15s[]
  leaderboard_daily_60s      LeaderboardDaily60s[]
  leaderboard_daily_15s      LeaderboardDaily15s[]
  settings                   UserSettings?
  user_xp                    UserXp?
  badges                     UserBadge[]

  @@map("users")
}

enum KeymapDisplayMode {
  off
  static
  react
  next
}

enum KeymapLegendStyle {
  lowercase
  uppercase
  blank
  dynamic
}

enum KeymapTopRowMode {
  always
  layout_dependent
  never
}

model UserXp {
  id                    Int       @id @default(autoincrement())

  user_id               String    @unique
  user                  User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  total_xp              Int       @default(0)
  current_level         Int       @default(0)

  current_streak_days   Int       @default(0)
  max_streak_days       Int       @default(0)
  last_streak_date      DateTime? @db.Date

  last_daily_bonus_date DateTime? @db.Date

  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@map("user_xp")
}

model UserSettings {
  id Int @id @default(autoincrement())

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  keymap_display_mode KeymapDisplayMode @default(react)
  keyboard_layout     String            @default("qwerty")
  keymap_legend_style KeymapLegendStyle @default(blank)
  keymap_top_row_mode KeymapTopRowMode  @default(always)
  keymap_size         Float             @default(1.0)
  show_hands_overlay  Boolean           @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@map("user_settings")
}

enum TypingCoachAiRunStatus {
  pending
  completed
  failed
}

model TypingCoachAiRun {
  id     Int    @id @default(autoincrement())
  user_id String
  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  status        TypingCoachAiRunStatus @default(pending)
  error_message String?

  input_snapshot Json

  model                     String

  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)

  feedbackItems TypingCoachAiFeedbackItem[]

  @@index([user_id])
  @@index([user_id, created_at])
  @@map("typing_coach_ai_runs")
}

model TypingCoachAiFeedbackItem {
  id    Int @id @default(autoincrement())
  run_id Int
  run   TypingCoachAiRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  sort_order    Int
  feedback_text String @db.Text
  practice_words Json

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([run_id, sort_order])
  @@index([run_id])
  @@map("typing_coach_ai_feedback_items")
}

model TypingResults {
  id                  Int       @id @default(autoincrement())
  user_id             String
  user                User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  wpm                 Float?
  raw_wpm             Float?
  accuracy            Float?
  consistency         Float?
  ended_at            DateTime? @db.Timestamptz(6)
  elapsed_seconds     Float?
  game_mode           String?
  target_time_seconds Int?
  target_word_count   Int?
  quote_length        String?
  language            String?
  punctuation         Boolean?  @default(false)
  numbers             Boolean?  @default(false)
  quote_id            String?
  quote_source        String?
  wpm_history         Int[]     @default([])
  raw_wpm_history     Int[]     @default([])
  burst_wpm           Int[]     @default([])
  incorrect_history   Int[]     @default([])
  word_mistakes       WordMistake[]

  leaderboard_all_time_60s LeaderboardAllTime60s?
  leaderboard_all_time_15s LeaderboardAllTime15s?
  leaderboard_daily_60s    LeaderboardDaily60s?
  leaderboard_daily_15s    LeaderboardDaily15s?

  badges UserBadge[]

  @@index([user_id])
  @@map("typing_results")
}

model UserBadge {
  id               Int       @id @default(autoincrement())

  user_id          String
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  badge_key        String
  unlocked_at      DateTime  @default(now()) @db.Timestamptz(6)

  source_result_id Int?
  source_result    TypingResults? @relation(fields: [source_result_id], references: [id], onDelete: SetNull)

  metadata         Json?

  @@unique([user_id, badge_key])
  @@index([user_id])
  @@index([user_id, unlocked_at])
  @@map("user_badges")
}

model WordMistake {
  word_id                 Int          @id @default(autoincrement())

  typing_result_id        Int
  typing_result           TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)

  word_index              Int
  words_reached_at_end    Int?

  target_word             String
  final_word              String
  final_status            String

  correction_count        Int          @default(0)
  backspace_count         Int          @default(0)

  word_length             Int
  contains_repeat_pattern Boolean      @default(false)
  contains_focus_bigram   Boolean      @default(false)
  contains_focus_trigram  Boolean      @default(false)

  start_time_ms           Int?
  end_time_ms             Int?
  duration_ms             Int?

  pause_count             Int          @default(0)
  max_pause_ms            Int          @default(0)

  error_count             Int          @default(0)

  created_at              DateTime     @default(now()) @db.Timestamptz(6)

  word_error_events       WordErrorEvent[]

  @@index([typing_result_id])
  @@index([typing_result_id, word_index])

  @@map("word_mistakes")
}

model WordErrorEvent {
  id                   Int          @id @default(autoincrement())

  word_mistake_id      Int
  word_mistake         WordMistake  @relation(fields: [word_mistake_id], references: [word_id], onDelete: Cascade)

  event_order          Int

  error_type           String

  corrected            Boolean?

  char_index_start     Int
  char_index_end       Int

  position_in_word     String

  expected_text        String
  actual_text          String

  pause_ms             Int?

  preceded_by_pause    Boolean      @default(false)

  details_jsonb        Json?

  created_at           DateTime     @default(now()) @db.Timestamptz(6)

  @@index([word_mistake_id])
  @@index([word_mistake_id, event_order])

  @@map("word_error_events")
}

model LeaderboardAllTime60s {
  id               Int           @id @default(autoincrement())
  // Leaderboard tables point to the saved TypingResults row instead of copying
  // WPM, accuracy and date into another table.
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  // The user_id is unique here, so each user can only have one all-time 60s
  // leaderboard entry: their best saved 60 second result.
  user_id          String        @unique
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("leaderboard_all_time_60s")
}

model LeaderboardAllTime15s {
  id               Int           @id @default(autoincrement())
  // This stores the linked best TypingResults row for the all-time 15s board.
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  // Unique user_id keeps one all-time 15s leaderboard row per user.
  user_id          String        @unique
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("leaderboard_all_time_15s")
}

model LeaderboardDaily60s {
  id               Int           @id @default(autoincrement())
  // Daily boards also store a reference to the result row, not duplicated score
  // values.
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  // Date-only field used for the UTC daily leaderboard reset.
  leaderboard_date DateTime      @db.Date

  // One daily 60s entry is allowed per user per UTC date.
  @@unique([user_id, leaderboard_date])
  @@index([leaderboard_date])
  @@map("leaderboard_daily_60s")
}

model LeaderboardDaily15s {
  id               Int           @id @default(autoincrement())
  // Linked typing result for this user's best 15s result on this UTC date.
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  leaderboard_date DateTime      @db.Date

  // One daily 15s entry is allowed per user per UTC date.
  @@unique([user_id, leaderboard_date])
  @@index([leaderboard_date])
  @@map("leaderboard_daily_15s")
}

model WeeklyXp {
  id                   Int      @id @default(autoincrement())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  xp                   Int      @default(0)
  time_typed_seconds   Float    @default(0)
  week_start           DateTime @db.Date
  ended_at             DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, week_start])
  @@index([week_start])
  @@map("weekly_xp")
}
