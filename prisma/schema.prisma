generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int    @id @default(autoincrement())
  user_id String @unique @default(dbgenerated("(auth.jwt() ->> 'sub'::text)"))

  typing_results             TypingResults[]
  weekly_xp                  WeeklyXp[]
  leaderboard_all_time_60s   LeaderboardAllTime60s[]
  leaderboard_all_time_15s   LeaderboardAllTime15s[]
  leaderboard_daily_60s      LeaderboardDaily60s[]
  leaderboard_daily_15s      LeaderboardDaily15s[]

  @@map("users")
}

model TypingResults {
  id                  Int       @id @default(autoincrement())
  user_id             String
  user                User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  wpm                 Float?
  raw_wpm             Float?
  accuracy            Float?
  consistency         Float?
  ended_at            DateTime? @db.Timestamptz(6)
  elapsed_seconds     Float?
  game_mode           String?
  target_time_seconds Int?
  target_word_count   Int?
  quote_length        String?
  language            String?
  punctuation         Boolean?  @default(false)
  numbers             Boolean?  @default(false)
  quote_id            String?
  quote_source        String?
  wpm_history         Int[]     @default([])
  raw_wpm_history     Int[]     @default([])
  burst_wpm           Int[]     @default([])
  incorrect_history   Int[]     @default([])
  word_mistakes       WordMistake[]

  leaderboard_all_time_60s LeaderboardAllTime60s?
  leaderboard_all_time_15s LeaderboardAllTime15s?
  leaderboard_daily_60s    LeaderboardDaily60s?
  leaderboard_daily_15s    LeaderboardDaily15s?

  @@index([user_id])
  @@map("typing_results")
}

model WordMistake {
  word_id                 Int          @id @default(autoincrement())

  typing_result_id        Int
  typing_result           TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)

  word_index              Int
  words_reached_at_end    Int?

  target_word             String
  final_word              String
  final_status            String

  correction_count        Int          @default(0)
  backspace_count         Int          @default(0)

  word_length             Int
  contains_repeat_pattern Boolean      @default(false)
  contains_focus_bigram   Boolean      @default(false)
  contains_focus_trigram  Boolean      @default(false)

  start_time_ms           Int?
  end_time_ms             Int?
  duration_ms             Int?

  pause_count             Int          @default(0)
  max_pause_ms            Int          @default(0)

  error_count             Int          @default(0)

  created_at              DateTime     @default(now()) @db.Timestamptz(6)

  word_error_events       WordErrorEvent[]

  @@index([typing_result_id])
  @@index([typing_result_id, word_index])

  @@map("word_mistakes")
}

model WordErrorEvent {
  id                   Int          @id @default(autoincrement())

  word_mistake_id      Int
  word_mistake         WordMistake  @relation(fields: [word_mistake_id], references: [word_id], onDelete: Cascade)

  event_order          Int

  error_type           String

  corrected            Boolean?

  char_index_start     Int
  char_index_end       Int

  position_in_word     String

  expected_text        String
  actual_text          String

  pause_ms             Int?

  preceded_by_pause    Boolean      @default(false)

  details_jsonb        Json?

  created_at           DateTime     @default(now()) @db.Timestamptz(6)

  @@index([word_mistake_id])
  @@index([word_mistake_id, event_order])

  @@map("word_error_events")
}

model LeaderboardAllTime60s {
  id               Int           @id @default(autoincrement())
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String        @unique
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("leaderboard_all_time_60s")
}

model LeaderboardAllTime15s {
  id               Int           @id @default(autoincrement())
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String        @unique
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("leaderboard_all_time_15s")
}

model LeaderboardDaily60s {
  id               Int           @id @default(autoincrement())
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  leaderboard_date DateTime      @db.Date

  @@unique([user_id, leaderboard_date])
  @@index([leaderboard_date])
  @@map("leaderboard_daily_60s")
}

model LeaderboardDaily15s {
  id               Int           @id @default(autoincrement())
  typing_result_id Int           @unique
  typing_result    TypingResults @relation(fields: [typing_result_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  leaderboard_date DateTime      @db.Date

  @@unique([user_id, leaderboard_date])
  @@index([leaderboard_date])
  @@map("leaderboard_daily_15s")
}

model WeeklyXp {
  id                   Int      @id @default(autoincrement())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  xp                   Int      @default(0)
  time_typed_seconds   Float    @default(0)
  week_start           DateTime @db.Date
  ended_at             DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, week_start])
  @@index([week_start])
  @@map("weekly_xp")
}
